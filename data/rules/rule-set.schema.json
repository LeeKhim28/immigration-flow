{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeeKhim28/immigration-flow/blob/main/data/rules/rule-set.schema.json",
  "title": "ImmigrationFlow deterministic rule set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_set_id", "version", "effective_from", "scope", "outcome_contract", "default_outcome", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "rule_set_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "effective_from": {"type": "string", "format": "date"},
    "scope": {"type": "object"},
    "outcome_contract": {
      "type": "array",
      "items": {"enum": ["pass", "action_required", "manual_review", "unsupported_scope"]},
      "uniqueItems": true
    },
    "default_outcome": {"const": "pass"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "description", "when", "then", "requirement_ids", "source_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^SPV1-RULE-[0-9]{3}$"},
          "priority": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "when": {"type": "object"},
          "then": {
            "type": "object",
            "required": ["outcome", "code", "message"],
            "properties": {
              "outcome": {"enum": ["pass", "action_required", "manual_review", "unsupported_scope"]},
              "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
              "message": {"type": "string"},
              "create_task": {"type": ["string", "null"]}
            }
          },
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
