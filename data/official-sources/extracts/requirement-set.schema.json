{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeeKhim28/immigration-flow/blob/main/data/official-sources/extracts/requirement-set.schema.json",
  "title": "ImmigrationFlow requirement set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirement_set_id", "version", "scope", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "requirement_set_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scope": {"type": "object"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "stage", "actor", "level", "statement", "condition", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^SPV1-REQ-[0-9]{3}$"},
          "category": {"enum": ["scope", "eligibility", "document", "workflow", "deadline", "manual_verification"]},
          "stage": {"enum": ["intake", "pre_submission", "post_eval", "pre_entry", "post_arrival", "endorsement"]},
          "actor": {"enum": ["applicant", "institution", "system", "immigration", "shared"]},
          "level": {"enum": ["required", "conditional", "recommended", "manual_check"]},
          "statement": {"type": "string", "minLength": 1},
          "condition": {"type": ["object", "string"]},
          "machine_handling": {"type": "string"},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "locator"],
              "properties": {
                "source_id": {"type": "string"},
                "locator": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}

