{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeeKhim28/immigration-flow/blob/main/data/official-sources/monitoring-baseline.schema.json",
  "title": "ImmigrationFlow official source monitoring baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baselines"],
  "properties": {
    "schema_version": {"const": 1},
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "canonical_url",
          "allowed_hosts",
          "strategy_version",
          "approved_hash",
          "captured_at",
          "git_commit_sha"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"},
          "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "allowed_hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "selector": {"type": ["string", "null"], "minLength": 1},
          "strategy_version": {"const": 1},
          "approved_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "captured_at": {"type": "string", "format": "date-time"},
          "git_commit_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
        }
      }
    }
  }
}
