{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeeKhim28/immigration-flow/blob/main/data/official-sources/source-record.schema.json",
  "title": "ImmigrationFlow official source record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "authority",
    "title",
    "canonical_url",
    "jurisdiction",
    "topics",
    "source_type",
    "language",
    "retrieved_at",
    "status"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"},
    "authority": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "jurisdiction": {"const": "Malaysia"},
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "source_type": {
      "enum": ["official_portal", "official_service_portal", "official_guidance", "official_form", "legislation", "official_guidebook"]
    },
    "language": {"enum": ["en", "ms", "bilingual"]},
    "retrieved_at": {"type": "string", "format": "date"},
    "reviewed_at": {"type": ["string", "null"], "format": "date"},
    "effective_from": {"type": ["string", "null"], "format": "date"},
    "effective_to": {"type": ["string", "null"], "format": "date"},
    "status": {"enum": ["candidate", "reviewed", "superseded", "retired"]},
    "supersedes": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}

